# Server-only values. Never prefix these with VITE_ and never put them in frontend code.

# Supabase → Project Settings → API.
# Use the service role key on the server only. It bypasses row-level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend notification email. RSVPs are still saved when these are unset,
# but no email is sent until all three values below are configured.
# 1. Create an account at https://resend.com
# 2. Add and verify your domain (Resend → Domains → add the DNS records they provide).
# 3. Set RSVP_FROM_EMAIL to an address on that verified domain.
# 4. Set RSVP_NOTIFY_EMAIL to the inbox that should receive each RSVP.
RESEND_API_KEY=re_your_resend_api_key
RSVP_FROM_EMAIL=Wedding RSVP <rsvp@yourdomain.com>
RSVP_NOTIFY_EMAIL=you@example.com

# Long random string. Required only for POST /api/notify, which retries a failed
# notification without creating another RSVP.
NOTIFY_RETRY_SECRET=replace-with-a-long-random-secret
