# Server-only values. Never prefix these with VITE_ and never put them in frontend code.

# Supabase → Project Settings → API.
# Use the service role key on the server only. It bypasses row-level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail notification. RSVPs are still saved when these are unset,
# but no email is sent until all three values below are configured.
# 1. On the sending Google account, turn on 2-Step Verification.
# 2. Create an App Password (Google Account → Security → App passwords).
# 3. GMAIL_USER is that sending account. RSVP_NOTIFY_EMAIL can be a different inbox.
GMAIL_USER=sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
RSVP_NOTIFY_EMAIL=you@example.com

# Long random string. Required only for POST /api/notify, which retries a failed
# notification without creating another RSVP.
NOTIFY_RETRY_SECRET=replace-with-a-long-random-secret

# Required for authenticated GET /api/daily-summary (Vercel Cron).
CRON_SECRET=replace-with-a-long-random-secret
